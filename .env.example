# JoshJTradez Academy — copy to .env and fill in. Never commit .env.
# Supabase dashboard -> Project Settings -> API

# Safe to expose to the browser (access is enforced by row-level security).
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security. Set in Vercel as a sensitive variable.
SUPABASE_SERVICE_ROLE_KEY=

# Email(s) of the academy owner (comma-separated). When this account signs in
# with a VERIFIED email it automatically becomes Owner + Teacher.
# Keep "Confirm email" switched ON in Supabase Auth for this to be safe.
ACADEMY_OWNER_EMAILS=

# Email(s) of the site developer. Gets a hidden Developer portal (diagnostics)
# plus access to every portal for testing. Nobody else ever sees this role.
ACADEMY_DEVELOPER_EMAILS=

# Email notifications for website enquiries (optional — enquiries are always
# saved and shown in the Owner portal → Enquiries even without this).
# Get a key at https://resend.com (create the Resend account with the email
# that should receive enquiries, or verify a domain and set CONTACT_FROM_EMAIL).
RESEND_API_KEY=
# Who receives enquiry emails (defaults to ACADEMY_OWNER_EMAILS).
CONTACT_NOTIFY_EMAIL=
# Sender address once a domain is verified in Resend (defaults to onboarding@resend.dev).
CONTACT_FROM_EMAIL=

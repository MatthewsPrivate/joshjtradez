---
import Eyebrow from "../ui/Eyebrow.astro";
import { PLATFORMS, SOCIAL_PLATFORMS } from "../../lib/content";

const ICON_PATHS: Record<string, string> = {
  youtube:
    "M23 7.2s-.2-1.6-.9-2.3c-.8-.9-1.7-.9-2.1-1C16.9 3.5 12 3.5 12 3.5s-4.9 0-8 .4c-.4.1-1.3.1-2.1 1C1.2 5.6 1 7.2 1 7.2S.8 9 .8 10.9v1.7C.8 14.5 1 16.4 1 16.4s.2 1.6.9 2.3c.8.9 2 .9 2.5 1 1.8.2 7.6.4 7.6.4s4.9 0 8-.4c.4-.1 1.3-.1 2.1-1 .7-.7.9-2.3.9-2.3s.2-1.9.2-3.8v-1.7C23.2 9 23 7.2 23 7.2zM10 14.6V8l6.2 3.3L10 14.6z",
  instagram:
    "M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.3.4.6.2 1 .5 1.5 1s.8.9 1 1.5c.2.5.3 1.1.4 2.3.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.3-.2.6-.5 1-1 1.5s-.9.8-1.5 1c-.5.2-1.1.3-2.3.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.3-.4-.6-.2-1-.5-1.5-1s-.8-.9-1-1.5c-.2-.5-.3-1.1-.4-2.3C2 15.6 2 15.2 2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.3.2-.6.5-1 1-1.5s.9-.8 1.5-1c.5-.2 1.1-.3 2.3-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.2 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.2.8s-.6.7-.8 1.2c-.1.4-.3 1-.4 2.1C2.7 9.8 2.7 10.1 2.7 13.3s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.2s.7.6 1.2.8c.4.1 1 .3 2.1.4 1.2.1 1.5.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.2-.8s.6-.7.8-1.2c.1-.4.3-1 .4-2.1.1-1.2.1-1.5.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.2s-.7-.6-1.2-.8c-.4-.1-1-.3-2.1-.4-1.2-.1-1.5-.1-4.7-.1zm0 3.1a4.9 4.9 0 110 9.8 4.9 4.9 0 010-9.8zm0 1.8a3.1 3.1 0 100 6.2 3.1 3.1 0 000-6.2zm5-2.2a1.1 1.1 0 110 2.2 1.1 1.1 0 010-2.2z",
  tiktok:
    "M21 8.4a8 8 0 01-4.6-1.5v6.8a6.4 6.4 0 11-6.4-6.4c.2 0 .5 0 .7.05V11a3.4 3.4 0 102.4 3.2V2h2.7a4.7 4.7 0 005.2 4.4v2z",
  discord:
    "M20.3 4.5A18 18 0 0016.4 3l-.2.4a16.6 16.6 0 014 1.3 13.5 13.5 0 00-15.4 0 16.6 16.6 0 014-1.3L8.6 3a18 18 0 00-3.9 1.5C2 9.4 1 14.2 1.5 19a17.3 17.3 0 005.5 2.8c.4-.6.8-1.2 1.1-1.8a11 11 0 01-1.7-.8c.1-.1.3-.2.4-.3a12 12 0 0011.4 0c.1.1.3.2.4.3a11 11 0 01-1.7.8c.3.6.7 1.2 1.1 1.8a17.3 17.3 0 005.5-2.8c.6-5.3-.6-10.1-3.2-14.5zM9 16c-1 0-2-1-2-2.2 0-1.3.9-2.3 2-2.3s2 1 2 2.3c0 1.2-.9 2.2-2 2.2zm6 0c-1 0-2-1-2-2.2 0-1.3.9-2.3 2-2.3s2 1 2 2.3c0 1.2-.9 2.2-2 2.2z",
};
---

<section id="community" class="section-rhythm platforms-section">
  <canvas class="cursor-trail-canvas" data-cursor-trail aria-hidden="true"></canvas>

  <div class="container-edge platforms-inner">
    <div class="platforms-head">
      <Eyebrow label={PLATFORMS.eyebrow} align="center" />
      <h2 class="t-h2 mt-6" style="text-align: center;" data-h2-reveal>{PLATFORMS.heading}</h2>
      <p class="t-body t-body-muted mt-6" style="text-align: center; margin-inline: auto; max-width: 60ch;">{PLATFORMS.sub}</p>
    </div>

    <div class="platforms-grid">
      {
        SOCIAL_PLATFORMS.map((p, i) => (
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={["platform-card", p.highlight && "platform-card--highlight"]}
            data-platform={p.id}
            data-platform-card
            data-platform-index={i}
            data-tilt
            data-tilt-max="8"
          >
            <div class="platform-art" aria-hidden="true">
              <span class="platform-category t-mono">{p.highlight ? "THE INNER CIRCLE" : ["WATCH & LEARN", "BEHIND THE TRADES", "QUICK TAKES"][i]}</span>
              <span class="platform-orbit platform-orbit--one"></span>
              <span class="platform-orbit platform-orbit--two"></span>
              <span class="platform-watermark">
                <svg viewBox="0 0 24 24"><path d={ICON_PATHS[p.id]} fill="currentColor" /></svg>
              </span>
              <span class="platform-icon">
                <svg viewBox="0 0 24 24" width="36" height="36"><path d={ICON_PATHS[p.id]} fill="currentColor" /></svg>
              </span>
              <span class="platform-art-label t-mono">{p.highlight ? "YOUR NEXT LEVEL STARTS HERE" : "@JOSHJTRADEZ"}</span>
            </div>
            <div class="platform-content">
              <div class="platform-title-row">
                <h3 class="t-h3">{p.name}</h3>
                {p.highlight && <span class="platform-badge">JOIN THE CREW</span>}
              </div>
              <p class="platform-blurb t-body">{p.blurb}</p>
              <span class="platform-cta t-mono">
                {p.cta}
                <span class="platform-arrow">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .platforms-section {
    position: relative;
    background: var(--bg-base);
    overflow: hidden;
  }

  .cursor-trail-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .platforms-inner {
    position: relative;
    z-index: 1;
  }

  .platforms-grid {
    margin-top: 64px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 640px) {
    .platforms-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1200px) {
    .platforms-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .platform-card {
    --accent: #ff6464;
    --accent-rgb: 255, 100, 100;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(150deg, #1b1b20, #101013 70%);
    color: var(--white);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 300ms ease, box-shadow 300ms ease, translate 400ms var(--ease-confident);
  }
  .platform-card[data-platform="instagram"] { --accent: #f696d2; --accent-rgb: 246, 150, 210; }
  .platform-card[data-platform="tiktok"] { --accent: #69e8df; --accent-rgb: 105, 232, 223; }
  .platform-card--highlight { --accent: var(--gold-400); --accent-rgb: 242, 199, 92; border-color: rgba(242, 199, 92, 0.42); }
  .platform-card:hover, .platform-card:focus-visible {
    translate: 0 -8px;
    border-color: var(--accent);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.4), 0 0 32px rgba(var(--accent-rgb), 0.12);
  }
  .platform-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }

  .platform-art {
    position: relative;
    height: 204px;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.18);
    background:
      radial-gradient(ellipse at 50% 80%, rgba(var(--accent-rgb), 0.23), transparent 70%),
      repeating-linear-gradient(0deg, transparent 0 31px, rgba(255, 255, 255, 0.035) 31px 32px),
      repeating-linear-gradient(90deg, transparent 0 31px, rgba(255, 255, 255, 0.035) 31px 32px),
      #111115;
  }
  .platform-category, .platform-art-label {
    position: absolute;
    z-index: 2;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.13em;
  }
  .platform-category { top: 20px; left: 22px; color: var(--accent); }
  .platform-category::before {
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    margin-right: 8px;
    vertical-align: 1px;
    box-shadow: 0 0 10px currentColor;
  }
  .platform-art-label { bottom: 16px; color: #b6b6bf; font-size: 8px; letter-spacing: 0.12em; }
  .platform-orbit {
    position: absolute;
    width: 154px;
    height: 154px;
    border: 1px solid rgba(var(--accent-rgb), 0.2);
    border-radius: 50%;
    transition: scale 600ms var(--ease-confident), rotate 600ms var(--ease-confident);
  }
  .platform-orbit--two { width: 234px; height: 234px; border-style: dashed; opacity: 0.5; }
  .platform-watermark {
    position: absolute;
    right: -25px;
    bottom: -35px;
    width: 170px;
    color: var(--accent);
    opacity: 0.07;
    rotate: -18deg;
    transition: rotate 600ms var(--ease-confident), scale 600ms var(--ease-confident);
  }
  .platform-watermark svg { width: 100%; height: auto; }
  .platform-icon {
    z-index: 1;
    width: 80px;
    height: 80px;
    border-radius: 23px;
    display: grid;
    place-items: center;
    color: var(--accent);
    background: linear-gradient(145deg, rgba(var(--accent-rgb), 0.2), #17171d 75%);
    border: 1px solid rgba(var(--accent-rgb), 0.5);
    box-shadow: 0 16px 28px #0007, inset 0 1px 0 #ffffff20;
    rotate: -9deg;
    transition: rotate 500ms var(--ease-confident), scale 500ms var(--ease-confident), box-shadow 500ms ease;
  }
  .platform-card:hover .platform-icon, .platform-card:focus-visible .platform-icon {
    rotate: 0deg;
    scale: 1.08;
    box-shadow: 0 16px 40px rgba(var(--accent-rgb), 0.2), inset 0 1px 0 #ffffff30;
  }
  .platform-card:hover .platform-orbit { scale: 1.12; rotate: 20deg; }
  .platform-card:hover .platform-watermark { rotate: -8deg; scale: 1.1; }

  .platform-content { display: flex; flex: 1; flex-direction: column; padding: 25px 24px 20px; }
  .platform-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .platform-title-row h3 { font-size: 26px; margin: 0; }
  .platform-badge {
    padding: 4px 7px;
    border: 1px solid rgba(var(--accent-rgb), 0.3);
    border-radius: 5px;
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.07);
    font: 8px var(--font-mono);
    letter-spacing: 0.07em;
  }
  .platform-blurb { color: #b1b1bb; font-size: 14px; line-height: 1.7; margin: 12px 0 25px; }
  .platform-cta {
    margin-top: auto;
    padding-top: 17px;
    border-top: 1px solid rgba(255,255,255,0.09);
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--accent);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .platform-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(var(--accent-rgb), 0.08);
    border: 1px solid rgba(var(--accent-rgb), 0.2);
    transition: background 250ms ease, color 250ms ease, rotate 250ms ease;
  }
  .platform-card:hover .platform-arrow, .platform-card:focus-visible .platform-arrow {
    background: var(--accent);
    color: #101013;
    rotate: 45deg;
  }
  .platform-card--highlight .platform-content { background: linear-gradient(145deg, rgba(var(--accent-rgb), 0.08), transparent 70%); }
  .platform-card--highlight .platform-icon { background: linear-gradient(145deg, #ffe4a1, #dca935); color: #18130a; }
  @media (prefers-reduced-motion: reduce) {
    .platform-card, .platform-card * { transition: none !important; }
    .platform-card:hover, .platform-card:focus-visible { translate: none; }
    .platform-card:hover .platform-icon, .platform-card:focus-visible .platform-icon,
    .platform-card:hover .platform-orbit, .platform-card:hover .platform-watermark { scale: 1; rotate: 0deg; }
  }

  /* Pre-states for orbit-in */
  .platforms-section[data-armed] [data-platform-card] {
    opacity: 0;
  }
</style>

<script>
  import { getGsap, prefersReducedMotion, isMobile } from "../../lib/motion-config";

  const section = document.querySelector<HTMLElement>(".platforms-section");
  const cards = document.querySelectorAll<HTMLElement>("[data-platform-card]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-cursor-trail]");

  // Cards orbit in from four corners — TL, TR, BL, BR.
  if (section && cards.length && !prefersReducedMotion()) {
    section.setAttribute("data-armed", "true");

    const corners = [
      { x: -120, y: -80 },
      { x:  120, y: -80 },
      { x: -120, y:  80 },
      { x:  120, y:  80 },
    ];

    getGsap().then(({ gsap, ScrollTrigger }) => {
      cards.forEach((card, i) => {
        const c = corners[i % corners.length]!;
        gsap.fromTo(
          card,
          { x: c.x, y: c.y, opacity: 0, rotate: i % 2 === 0 ? -8 : 8 },
          {
            x: 0,
            y: 0,
            opacity: 1,
            rotate: 0,
            duration: 1.0,
            delay: i * 0.08,
            ease: "power3.out",
            scrollTrigger: {
              trigger: section,
              start: "top 70%",
              once: true,
            },
          },
        );
      });
      ScrollTrigger.refresh();
    });
  }

  // Particle cursor trail (~60 particles, 800ms tail decay).
  // Skipped on touch / reduced-motion / mobile.
  if (canvas && !prefersReducedMotion() && !isMobile() && !("ontouchstart" in window)) {
    const ctx = canvas.getContext("2d");
    if (ctx) {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.25);
      let raf = 0;
      const particles: { x: number; y: number; vx: number; vy: number; life: number }[] = [];
      const MAX = 36;
      const LIFE = 0.8; // seconds

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        canvas.width = r.width * dpr;
        canvas.height = r.height * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();

      let lastT = performance.now();
      const onMove = (e: MouseEvent) => {
        const r = canvas.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        if (x < 0 || y < 0 || x > r.width || y > r.height) return;
        // Spawn 1–2 particles per move with a small jitter
        for (let i = 0; i < 2; i++) {
          if (particles.length >= MAX) particles.shift();
          particles.push({
            x,
            y,
            vx: (Math.random() - 0.5) * 24,
            vy: (Math.random() - 0.5) * 24 - 8,
            life: LIFE,
          });
        }
        if (!raf && !document.hidden) { lastT = performance.now(); raf = requestAnimationFrame(tick); }
      };

      const tick = () => {
        const now = performance.now();
        const dt = Math.min((now - lastT) / 1000, 0.05);
        lastT = now;
        const r = canvas.getBoundingClientRect();
        ctx.clearRect(0, 0, r.width, r.height);

        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i]!;
          p.life -= dt;
          if (p.life <= 0) {
            particles.splice(i, 1);
            continue;
          }
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.vy += 14 * dt; // soft gravity for a downward drift
          const a = p.life / LIFE;
          ctx.beginPath();
          ctx.fillStyle = `rgba(229, 179, 68, ${a * 0.7})`;
          ctx.arc(p.x, p.y, 2 + 2 * a, 0, Math.PI * 2);
          ctx.fill();
        }

        raf = particles.length && !document.hidden ? requestAnimationFrame(tick) : 0;
      };

      const onScrollIn = new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            if (en.isIntersecting) {
              window.addEventListener("mousemove", onMove);
              raf = particles.length && !document.hidden ? requestAnimationFrame(tick) : 0;
            } else {
              window.removeEventListener("mousemove", onMove);
              cancelAnimationFrame(raf); raf = 0; particles.length = 0;
            }
          }
        },
        { threshold: 0 },
      );
      onScrollIn.observe(section!);

      window.addEventListener("resize", resize);
    }
  }
</script>

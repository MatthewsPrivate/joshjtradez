---
// Shared lightbox modal — wired via [data-lightbox-trigger] elsewhere on the page.
// Trigger contract:
//   - element exposes `data-lightbox-title` and (optional) `data-lightbox-meta`
//   - clicking opens the modal with that copy + a placeholder image block
---

<dialog class="lightbox" data-lightbox aria-labelledby="lightbox-title">
  <button
    type="button"
    class="lightbox-close"
    data-lightbox-close
    aria-label="Close"
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="lightbox-stage">
    <p class="t-eyebrow" data-lightbox-eyebrow>Document</p>
    <h3 class="t-h2 mt-4" id="lightbox-title" data-lightbox-title>Title</h3>
    <p class="t-mono mt-3" data-lightbox-meta style="color: var(--white-muted);">Meta</p>

    <div class="lightbox-image">
      <img class="lightbox-img" data-lightbox-img alt="" />
      <div class="lightbox-fallback" data-lightbox-fallback>
        <span class="ph-label">HIGH RES IMAGE</span>
        <span class="t-mono" style="color: var(--white-muted);">Drop the asset in /public/proof/ and it shows up here.</span>
      </div>
    </div>
  </div>
</dialog>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(960px, 92vw);
    max-height: 92vh;
    border: 1px solid var(--gold-500);
    background: var(--bg-elev-1);
    color: var(--white);
    border-radius: 18px;
    padding: 0;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7), 0 0 60px rgba(229, 179, 68, 0.18);
  }
  .lightbox::backdrop {
    background: rgba(10, 10, 11, 0.78);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .lightbox[open] {
    animation: lb-in 280ms var(--ease-confident);
  }
  @keyframes lb-in {
    from { transform: scale(0.96); opacity: 0; }
    to   { transform: scale(1);    opacity: 1; }
  }

  .lightbox-stage {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .lightbox-image {
    position: relative;
    margin-top: 24px;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    background-color: var(--bg-elev-2);
    background-image:
      linear-gradient(180deg, rgba(229,179,68,0.10) 0%, transparent 60%),
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 100% 100%, 24px 24px, 24px 24px;
    border: 1px solid rgba(229, 179, 68, 0.20);
    overflow: hidden;
    color: var(--white-muted);
  }
  .lightbox-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .lightbox-img:not([src]) { display: none; }
  .lightbox-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    padding: 16px;
  }
  .lightbox-image:has(.lightbox-img[src]) .lightbox-fallback { display: none; }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: var(--bg-base);
    border: 1px solid var(--gold-500);
    color: var(--gold-500);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1;
    transition: background 200ms var(--ease-confident),
                color 200ms var(--ease-confident);
  }
  .lightbox-close:hover {
    background: var(--gold-500);
    color: var(--bg-base);
  }
</style>

<script>
(function() {
  const dlg = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const eyebrow = dlg?.querySelector<HTMLElement>("[data-lightbox-eyebrow]");
  const titleEl = dlg?.querySelector<HTMLElement>("[data-lightbox-title]");
  const metaEl = dlg?.querySelector<HTMLElement>("[data-lightbox-meta]");
  const imgEl = dlg?.querySelector<HTMLImageElement>("[data-lightbox-img]");
  const closeBtn = dlg?.querySelector<HTMLElement>("[data-lightbox-close]");

  if (dlg) {
    document.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        "[data-lightbox-trigger]",
      );
      if (!trigger) return;
      e.preventDefault();
      const title = trigger.dataset.lightboxTitle ?? "Document";
      const meta = trigger.dataset.lightboxMeta ?? "";
      const eyebrowText = trigger.dataset.lightboxEyebrow ?? "Document";
      const imageSrc = trigger.dataset.lightboxImage ?? "";
      if (titleEl) titleEl.textContent = title;
      if (metaEl) metaEl.textContent = meta;
      if (eyebrow) eyebrow.textContent = eyebrowText;
      if (imgEl) {
        imgEl.onerror = () => {
          imgEl.removeAttribute("src");
        };
        if (imageSrc) {
          imgEl.src = imageSrc;
          imgEl.alt = title;
        } else {
          imgEl.removeAttribute("src");
          imgEl.removeAttribute("alt");
        }
      }
      dlg.showModal();
    });

    closeBtn?.addEventListener("click", () => dlg.close());
    dlg.addEventListener("click", (e) => {
      // Close on backdrop click — clicks on the dialog content keep it open.
      const rect = dlg.getBoundingClientRect();
      const inside =
        e.clientX >= rect.left && e.clientX <= rect.right &&
        e.clientY >= rect.top && e.clientY <= rect.bottom;
      if (!inside) dlg.close();
    });
  }
})();
</script>

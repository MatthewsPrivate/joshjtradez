---
// Floating "Chat with Josh" button (bottom-right) linking to WhatsApp.
// Renders nothing until WHATSAPP.number is set in src/lib/content.ts.
import { WHATSAPP, whatsappHref } from "../../lib/content";

const href = whatsappHref();
---

{
  href && (
    <a class="wa-float" href={href} target="_blank" rel="noopener noreferrer" aria-label={`${WHATSAPP.buttonLabel} on WhatsApp`}>
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.43 9.43 0 01-4.8-1.32l-.35-.2-3.57.94.96-3.48-.23-.36a9.4 9.4 0 01-1.44-5.02c0-5.2 4.24-9.44 9.45-9.44a9.4 9.4 0 016.68 2.77 9.38 9.38 0 012.76 6.68c0 5.21-4.24 9.44-9.45 9.44zm8.04-17.48A11.32 11.32 0 0012.04.7C5.77.7.67 5.8.67 12.06c0 2 .52 3.96 1.52 5.68L.57 23.65l6.05-1.59a11.33 11.33 0 005.42 1.38h.01c6.26 0 11.37-5.1 11.37-11.37 0-3.04-1.18-5.89-3.34-8.05z"
        />
      </svg>
      <span class="wa-label">{WHATSAPP.buttonLabel}</span>
    </a>
  )
}

<style>
  .wa-float {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 90; /* below the intro transition (200) and lightbox */
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding: 0 16px;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--gold-500), var(--gold-400));
    color: var(--bg-base);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 0 0 var(--gold-glow);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition:
      transform 200ms var(--ease-confident),
      box-shadow 200ms var(--ease-confident);
  }
  .wa-float:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5), 0 0 24px var(--gold-glow);
  }
  .wa-float:focus-visible {
    outline: 2px solid var(--gold-300);
    outline-offset: 3px;
  }
  /* Phones: icon-only circle so it doesn't cover content. */
  @media (max-width: 640px) {
    .wa-float {
      width: 56px;
      padding: 0;
      justify-content: center;
    }
    .wa-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      transition: none;
    }
  }
</style>

---
// Renders ?error= / ?notice= codes from the URL as fixed, known messages.
// Unknown codes render nothing, so the query string can't inject text.
const MESSAGES: Record<string, string> = {
  // errors
  missing: "Please fill in every field.",
  "bad-login": "That email and password don't match an account.",
  unconfirmed: "Please confirm your email first — check your inbox for the link.",
  weak: "Use a password of at least 10 characters.",
  mismatch: "The two passwords don't match.",
  same: "Choose a password you haven't used on this account.",
  failed: "Something went wrong. Please try again.",
  "link-expired": "That link has expired or was already used. Please request a new one.",
  "not-found": "That item no longer exists.",
  "not-allowed": "You don't have permission to do that.",
  invalid: "Some details were missing or invalid. Please check and try again.",
  "has-enrolments": "This course has enrolled students, so it can't be deleted. Archive it instead.",
  "slug-taken": "That web address is already used by another course. Choose a different one.",
  "upload-failed": "The upload didn't finish. Please try again.",
  "bad-video-url": "That video link isn't supported. Use a YouTube or Vimeo link, or upload the video file.",
  "user-not-found": "No account uses that email yet. Ask them to create an account first.",
  // notices
  saved: "Changes saved.",
  created: "Created.",
  deleted: "Deleted.",
  published: "Published — students with access can now see it.",
  enrolled: "Access granted.",
  "access-removed": "Access removed.",
  "demo-created": "Demo course created. It's a draft with placeholder content — edit it or delete it any time.",
  "check-email": "Check your inbox to confirm your email address, then sign in.",
  "signed-out": "You've been signed out.",
  sent: "If an account exists for that email, a reset link is on its way.",
  "password-updated": "Your password has been updated.",
  denied: "You don't have access to that portal.",
};

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice") ?? (Astro.url.searchParams.get("denied") ? "denied" : null);
const errorText = error ? MESSAGES[error] : undefined;
const noticeText = notice ? MESSAGES[notice] : undefined;
---

{errorText && <p class="flash flash-error" role="alert">{errorText}</p>}
{noticeText && <p class="flash flash-notice" role="status">{noticeText}</p>}

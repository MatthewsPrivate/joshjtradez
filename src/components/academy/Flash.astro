---
// Renders ?error= / ?notice= codes from the URL as fixed, known messages.
// Unknown codes render nothing, so the query string can't inject text.
const MESSAGES: Record<string, string> = {
  // errors
  missing: "Please fill in every field.",
  "bad-login": "That email and password don't match an account.",
  unconfirmed: "Please confirm your email first — check your inbox for the link.",
  weak: "Use a password of at least 10 characters.",
  mismatch: "The two passwords don't match.",
  same: "Choose a password you haven't used on this account.",
  failed: "Something went wrong. Please try again.",
  "link-expired": "That link has expired or was already used. Please request a new one.",
  "not-found": "That item no longer exists.",
  "not-allowed": "You don't have permission to do that.",
  invalid: "Some details were missing or invalid. Please check and try again.",
  "has-enrolments": "This course has enrolled students, so it can't be deleted. Archive it instead.",
  "slug-taken": "That web address is already used by another course. Choose a different one.",
  "upload-failed": "The upload didn't finish. Please try again.",
  "bad-video-url": "That video link isn't supported. Use a YouTube or Vimeo link, or upload the video file.",
  "user-not-found": "No account uses that email yet. Ask them to create an account first.",
  "trade-missing": "Add the instrument, direction and entry price.",
  "bad-number": "One of the prices or amounts isn't a valid number.",
  "bad-dates": "The exit time is before the entry time.",
  "too-many-screenshots": "That trade already has the maximum number of screenshots.",
  "review-open": "This trade is with Josh for review. Withdraw the request before making it private.",
  "bad-price": "Enter a name and a price of at least 1.00 (e.g. 297 or 297.50).",
  "no-courses": "Tick at least one course for this product to unlock.",
  "code-wrong": "That code isn't right. Check the latest email and try again.",
  "code-expired": "That code has expired. Use “resend code” to get a new one.",
  "code-locked": "Too many wrong attempts. Use “resend code” to get a new one.",
  "code-cooldown": "A code was just sent — please wait a minute before asking for another.",
  "code-limit": "Too many codes requested for this purchase. Please contact us and we'll help.",
  "email-failed": "We couldn't send the email just now. Please try again in a minute.",
  "mfa-wrong": "That code isn't right. Codes change every 30 seconds — try the current one.",
  "mfa-required": "Your account role needs two-factor authentication. Set it up to continue.",
  "payments-off": "Online checkout isn't open yet. Please contact us to enrol.",
  "product-unavailable": "That course isn't available to buy right now.",
  "checkout-failed": "We couldn't start the checkout. Please try again.",
  "not-paid": "We couldn't confirm that payment yet. Please wait a moment and refresh.",
  // notices
  saved: "Changes saved.",
  "product-archived": "This product has sales, so it was hidden from sale instead of deleted.",
  "code-sent": "New code sent. Check your inbox.",
  "mfa-enabled": "Two-factor authentication is on. You'll be asked for a code when you sign in.",
  "mfa-disabled": "Two-factor authentication has been turned off.",
  "checkout-cancelled": "Checkout cancelled — you haven't been charged.",
  "already-enrolled": "You already have access to that course.",
  "purchase-complete": "Payment confirmed — welcome! Your course is unlocked.",
  "account-exists": "You already have an account with that email. Sign in and your purchase will be there.",
  "account-ready": "Your account is ready. Sign in to start learning.",
  "trade-saved": "Trade saved. Add a chart screenshot or send it to Josh for feedback.",
  "review-requested": "Sent to Josh. You'll get a notification when he replies.",
  "review-cancelled": "Review request withdrawn.",
  "feedback-sent": "Feedback sent. The student has been notified.",
  "reply-sent": "Reply sent.",
  created: "Created.",
  deleted: "Deleted.",
  published: "Published — students with access can now see it.",
  enrolled: "Access granted.",
  "access-removed": "Access removed.",
  "demo-created": "Demo course created. It's a draft with placeholder content — edit it or delete it any time.",
  "check-email": "Check your inbox to confirm your email address, then sign in.",
  "signed-out": "You've been signed out.",
  sent: "If an account exists for that email, a reset link is on its way.",
  "password-updated": "Your password has been updated.",
  denied: "You don't have access to that portal.",
};

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice") ?? (Astro.url.searchParams.get("denied") ? "denied" : null);
const errorText = error ? MESSAGES[error] : undefined;
const noticeText = notice ? MESSAGES[notice] : undefined;
---

{errorText && <p class="flash flash-error" role="alert">{errorText}</p>}
{noticeText && <p class="flash flash-notice" role="status">{noticeText}</p>}

---
import AcademyLayout from "../../layouts/AcademyLayout.astro";
import { Logo } from "../../components/academy/ui";
import Flash from "../../components/academy/Flash.astro";

export const prerender = false;

const user = Astro.locals.user!;
---

<AcademyLayout title="Account settings">
  <main class="auth-wrap">
    <div class="auth-card card">
      <a href="/academy" aria-label="JoshJTradez"><Logo /></a>
      <h1>Account settings</h1>
      <p class="lede">{user.email}</p>
      <Flash />

      <form class="form-stack settings-section" method="post" action="/api/academy/auth/reset">
        <span class="kicker">CHANGE PASSWORD</span>
        <label>New password<input type="password" name="password" autocomplete="new-password" minlength="10" required /></label>
        <label>Confirm password<input type="password" name="password_confirm" autocomplete="new-password" minlength="10" required /></label>
        <button type="submit" class="btn btn-outline">Update password</button>
      </form>

      <div class="auth-links"><a href="/academy">Back to portals</a></div>
    </div>
  </main>
</AcademyLayout>

---
import AcademyLayout from "../../layouts/AcademyLayout.astro";
import { Logo } from "../../components/academy/ui";
import Flash from "../../components/academy/Flash.astro";

export const prerender = false;
---

<AcademyLayout title="Reset password">
  <main class="auth-wrap">
    <div class="auth-card card">
      <a href="/" aria-label="JoshJTradez"><Logo /></a>
      <h1>Reset your password</h1>
      <p class="lede">We'll email you a link to choose a new one.</p>
      <Flash />
      <form class="form-stack" method="post" action="/api/academy/auth/forgot">
        <label>Email<input type="email" name="email" autocomplete="email" required /></label>
        <button type="submit" class="btn btn-primary">Send reset link</button>
      </form>
      <div class="auth-links"><a href="/academy/login">Back to sign in</a></div>
    </div>
  </main>
</AcademyLayout>
